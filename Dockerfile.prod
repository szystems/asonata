# Dockerfile.prod — Asonata (Laravel 8 + Mix)
# Assets CSS/JS pre-compilados con: npm install --legacy-peer-deps && npm run production

# =============================================================================
# Stage 1: PHP base
# =============================================================================
FROM php:8.0-fpm-alpine AS php-base

RUN apk add --no-cache \
    linux-headers \
    $PHPIZE_DEPS \
    libzip-dev \
    zip \
    unzip \
    git \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    oniguruma-dev \
    icu-dev \
    netcat-openbsd \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Límites de subida/POST (inscripción de atleta sube hasta 5 archivos).
# Se hereda en los stages app y scheduler.
COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

# =============================================================================
# Stage 2: PHP builder (dependencias Composer)
# =============================================================================
FROM php-base AS php-builder

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-scripts \
    --prefer-dist

# =============================================================================
# Stage 3: App final
# =============================================================================
FROM php-base AS app

WORKDIR /app

COPY . .
COPY --from=php-builder /app/vendor ./vendor

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
